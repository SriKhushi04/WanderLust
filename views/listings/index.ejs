<% layout('layouts/boilerplate') %>
<body>
    <h3>All Listings</h3>
    

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let listings of allListings) { %><a class = "listing-link" href = "/listings/<%=listings._id%>">
        <div class="card col">
        <img src="<%= listings.image.url %>"  style="height: 20rem" class="card-img-top">
        <div class = "card-img-overlay"></div>
        <div class="card-body">
        <p class="card-text">
            <b><%=listings.title %> </b><br>
            &#8377;<%=listings.price.toLocaleString("en-IN") %> <br>

        </p>
        </div>
        </div></a>
    <% } %>
    </div>

    <ul>
        <% for( let listing of allListings) { %>
            <li><a href = "/listings/<%= listing._id %>"><%= listing.title %></a></li>
        <% } %>
    </ul>
</body>
</html>

