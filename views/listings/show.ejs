<% layout('layouts/boilerplate') %>

    <br><br>

    <div class="row">
        <div class="col-8 offset-2">

            <h3>Listing Details</h3>
            <br>

            <div class="card" style="width: 100%;">

                <img src="<%= listing.image.url %>" class="card-img-top" style="height: 25rem; object-fit: cover;"
                    alt="<%= listing.title %>">

                <div class="card-body">

                    <h5 class="card-title">
                        <%= listing.title %>
                    </h5>

                    <p class="card-text">
                        <%= listing.description %>
                    </p>

                    <p class="card-text">
                        <b>Price:</b> &#8377;
                        <%= listing.price.toLocaleString("en-IN") %>
                    </p>

                    <p class="card-text">
                        <b>Location:</b>
                        <%= listing.location %>
                    </p>

                    <p class="card-text">
                        <b>Country:</b>
                        <%= listing.country %>
                    </p>

                    <div class="d-flex gap-2">

                        <form method="GET" action="/listings/<%= listing._id %>/edit">
                            <button class="btn btn-dark">
                                Edit Listing
                            </button>
                        </form>

                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-danger">
                                Delete Listing
                            </button>
                        </form>

                    </div>

                </div>
            </div>

            <br><br>

        </div>
    </div>
