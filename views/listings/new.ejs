<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Listing</title>
</head>
<body>
    <h3> Create New Listing </h3>
    <form method = "POST" action = "/listings">
        <input name = "listing[title]" placeholder = "Enter Title">
        <br>
        <textarea name = "listing[description]" placeholder = "Enter Description"></textarea>
        <br>
        <input name = "listing[image]" placeholder = "Image URL/Link">
        <br>
        <input name = "listing[price]" placeholder = "Enter Price" type = "number">
        <br>
        <input name = "listing[location]" placeholder = "Enter Location" required>
        <br>
        <input name = "listing[country]" placeholder = "Enter Country" required>
        <br>
        <button type = "submit">Create Listing</button>
    </form>
    
</body>
</html>